  "userRoles": [
    {
      "role": "admin",
      "description": "Full system access",
      "permissions": [
        "dashboard.view",
        "posts.create",
        "posts.view",
        "posts.update",
        "posts.delete",
        "pages.create",
        "pages.view",
        "pages.update",
        "pages.delete",
        "categories.create",
        "categories.view",
        "categories.delete",
        "media.upload",
        "media.view",
        "media.delete",
        "settings.manage",
        "users.manage",
        "roles.manage",
        "menus.manage",
        "activity.view",
        "backups.manage"
      ]
    },
    {
      "role": "editor",
      "description": "Can manage posts and pages",
      "permissions": [
        "dashboard.view",
        "posts.create",
        "posts.view",
        "posts.update",
        "posts.delete",
        "pages.create",
        "pages.view",
        "pages.update",
        "pages.delete",
        "categories.view",
        "media.upload",
        "media.view",
        "activity.view"
      ]
    },
    {
      "role": "post_editor",
      "description": "Can only manage posts",
      "permissions": [
        "dashboard.view",
        "posts.create",
        "posts.view",
        "posts.update",
        "posts.delete",
        "categories.view",
        "media.upload",
        "media.view"
      ]
    },
    {
      "role": "page_editor",
      "description": "Can only manage pages",
      "permissions": [
        "dashboard.view",
        "pages.create",
        "pages.view",
        "pages.update",
        "pages.delete",
        "media.upload",
        "media.view"
      ]
    }
  ],
  "features": [
    {
      "name": "Blog Post Management",
      "description": "Create, edit, and publish blog posts with categories, tags, featured images, and SEO metadata",
      "models": ["Post", "Category", "Tag"],
      "controllers": ["PostController", "CategoryController"],
      "status": "active"
    },
    {
      "name": "Page Management",
      "description": "Create and manage custom pages with page versioning and drag-and-drop builder support",
      "models": ["Page", "PageVersion"],
      "controllers": ["PageController", "PageVersionController"],
      "status": "active"
    },
    {
      "name": "Media Library",
      "description": "Upload and manage media files with access tracking",
      "models": ["Media"],
      "controllers": ["MediaController"],
      "status": "active"
    },
    {
      "name": "Site Settings",
      "description": "Configure site identity, home page, header, and footer content",
      "models": ["Setting", "HeaderTemplate", "FooterTemplate"],
      "controllers": ["SettingController", "HeaderTemplateController", "FooterTemplateController"],
      "status": "active"
    },
    {
      "name": "User Management",
      "description": "Manage system users with role-based access control",
      "models": ["User"],
      "controllers": ["UserManagementController"],
      "status": "active"
    },
    {
      "name": "Activity Logging",
      "description": "Track all user actions for audit purposes",
      "models": ["ActivityLog"],
      "controllers": ["ActivityLogController"],
      "status": "active"
    },
    {
      "name": "Navigation Menus",
      "description": "Create and manage nested navigation menus",
